# Secrets ESPHome
secrets.yaml
.esphome/

# Scripts production (contiennent credentials)
*_prod.py
tools/config.json

# Fichiers temporaires
*.pyc
__pycache__/
*.log
.DS_Store

# Captures temporaires (garder seulement les exemples)
captures/*.bin
!captures/example_*.bin

# IDE
.vscode/
.idea/

# Résultats de tests (garder .gitkeep, rapports et templates)
tests/results/*
!tests/results/.gitkeep
!tests/results/rapport_reference_*.md
!tests/results/rapport_recherche_*.md
!tests/results/sniff_aide_memoire.md
!tests/results/sniff_X*_*.md
!tests/results/sniff_Y*_*.md
